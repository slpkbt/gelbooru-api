  "description": "Modern and professional NodeJS wrapper for Gelbooru API with full backward compatibility",
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slpkbt/gelbooru-api.git"
